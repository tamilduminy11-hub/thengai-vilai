{
  "hosting": {
    "public": "app/build/web",
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/thengai-vilai.apk",
        "destination": "https://github.com/tamilduminy11-hub/thengai-vilai/releases/latest/download/thengai-vilai.apk",
        "type": 302
      },
      {
        "source": "/app",
        "destination": "https://github.com/tamilduminy11-hub/thengai-vilai/releases/latest/download/thengai-vilai.apk",
        "type": 302
      }
    ]
  }
}